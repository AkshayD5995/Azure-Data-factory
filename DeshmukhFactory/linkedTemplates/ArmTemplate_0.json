{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DeshmukhFactory"
		},
		"ADLS_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_LS'"
		},
		"ADLS_LS_HEALTHCARE_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_LS_HEALTHCARE'"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"AzureSqlDatabaseforincreamental_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaseforincreamental'"
		},
		"LS_SQLDB_SRC_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLDB_SRC'"
		},
		"SQL_ls_HEALTHCARE_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SQL_ls_HEALTHCARE'"
		},
		"azureDB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'azureDB'"
		},
		"healthcare_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'healthcare'"
		},
		"ADLS_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://practise.dfs.core.windows.net/"
		},
		"ADLS_LS_HEALTHCARE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://projecthealthcare.dfs.core.windows.net/"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://eatsstorage1.dfs.core.windows.net/"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azuredbserverdb.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_practise"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "akshu"
		},
		"AzureSqlDatabaseforincreamental_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "eatsuber.database.windows.net"
		},
		"AzureSqlDatabaseforincreamental_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "uber"
		},
		"AzureSqlDatabaseforincreamental_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CloudSA94fab8ec"
		},
		"LS_SQLDB_SRC_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "eatsuber.database.windows.net"
		},
		"LS_SQLDB_SRC_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "uber"
		},
		"LS_SQLDB_SRC_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CloudSA94fab8ec"
		},
		"SQL_ls_HEALTHCARE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "serverhealth.database.windows.net"
		},
		"SQL_ls_HEALTHCARE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().database}"
		},
		"SQL_ls_HEALTHCARE_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "akshay"
		},
		"azureDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "serverhealth.database.windows.net"
		},
		"azureDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "healthA"
		},
		"azureDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "akshay"
		},
		"healthcare_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "serverhealth.database.windows.net"
		},
		"healthcare_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DBName}"
		},
		"healthcare_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "akshay"
		}
	},
