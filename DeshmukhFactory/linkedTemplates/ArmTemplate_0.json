					"server": "[parameters('SQL_ls_HEALTHCARE_properties_typeProperties_server')]",
					"database": "[parameters('SQL_ls_HEALTHCARE_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('SQL_ls_HEALTHCARE_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('SQL_ls_HEALTHCARE_password')]"
