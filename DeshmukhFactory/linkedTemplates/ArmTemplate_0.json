					"server": "[parameters('AzureSqlDatabaseforincreamental_properties_typeProperties_server')]",
					"database": "[parameters('AzureSqlDatabaseforincreamental_properties_typeProperties_database')]",
					"encrypt": "optional",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('AzureSqlDatabaseforincreamental_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('AzureSqlDatabaseforincreamental_password')]"
					}
