		{
			"name": "[concat(parameters('factoryName'), '/healthcare')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"parameters": {
					"DBName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('healthcare_properties_typeProperties_server')]",
					"database": "[parameters('healthcare_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
