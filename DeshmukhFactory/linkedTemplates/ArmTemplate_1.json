												"value": "@concat('\nSELECT DISTINCT \n    d.SalesOrderID,\n    d.SalesOrderDetailID,\n    d.ProductID,\n    A.CountryRegion, \n    FORMAT(H.OrderDate, ''yyyy-MM'') AS MONTHFOLDER\nFROM SalesLT.SalesOrderDetail AS d\nJOIN SalesLT.SalesOrderHeader AS H ON H.SalesOrderID = d.SalesOrderID\nJOIN SalesLT.CustomerAddress AS CA ON CA.CustomerID = H.CustomerID\nJOIN SalesLT.Address AS A ON A.AddressID = CA.AddressID\nWHERE A.CountryRegion = ''', item().CountryRegion, ''' \n  AND FORMAT(H.OrderDate, ''yyyy-MM'') = ''', item().MONTHFOLDER, '''\n')\n",
												"type": "Expression"
